# Version control, local tools, and project-only material
.git
.github
.agents
.claude
.mpg
.omc
conductor
docs

# Secrets and environment variants
.env
.env.*
**/.env
**/.env.*

# JavaScript dependencies, builds, and tests
node_modules
.next
out
dist
build
coverage
*.tsbuildinfo

# Python environments, caches, and tests
.venv
venv
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage*
**/htmlcov

# Logs and runtime state
*.log
**/*.log
logs
**/logs
*.pid
*.pid.lock
.cache
**/.cache
tmp
temp

# Local data and service volumes
data
docker-data
valhalla-tiles
photon-data
martin-data

# Root image does not need development scripts or unrelated infrastructure
infra/*
!infra/martin/
!infra/martin/martin.yaml

# Only the scripts the image itself runs: the build-stage data-boundary gate
# (and the two checks it imports) plus the pre-deploy migration runner.
scripts/*
!scripts/check-client-provider-urls.mjs
!scripts/check-client-server-imports.mjs
!scripts/check-data-boundaries.mjs
!scripts/migrate.mjs
