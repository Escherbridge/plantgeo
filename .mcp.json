{
  "mcpServers": {
    "plantgeo-warehouse": {
      "command": "uv",
      "args": ["run", "--no-sync", "agri-service", "agent", "mcp-serve"],
      "cwd": "services/agri-data-service",
      "env": {
        "UV_NO_SYNC": "1"
      }
    },
    "strategy-knowledge": {
      "command": "uv",
      "args": ["run", "--no-sync", "strategy-kb", "serve"],
      "cwd": "services/strategy-knowledge",
      "env": {
        "UV_NO_SYNC": "1"
      }
    }
  }
}
