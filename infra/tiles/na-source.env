# Input source config for the North America PMTiles basemap build.
# Sourced by build-na.sh. Not committed secrets; safe to check in.

# Geofabrik North America extract (OSM). Geofabrik regenerates this daily;
# "north-america-latest" always resolves to the current build, so re-running
# build-na.sh after an OSM refresh naturally picks up new data.
GEOFABRIK_PBF_URL="https://download.geofabrik.de/north-america-latest.osm.pbf"
GEOFABRIK_MD5_URL="https://download.geofabrik.de/north-america-latest.osm.pbf.md5"

# Approximate size as of authoring this config — CONFIRM against the
# Content-Length Geofabrik actually serves at download time; Geofabrik's
# North America extract has historically run ~10-13 GB compressed and
# grows over time as OSM data density increases. build-na.sh prints the
# real downloaded size; treat this constant only as a rough disk-planning
# figure, not a check.
GEOFABRIK_PBF_APPROX_SIZE_GB=12

# Planetiler output. PMTiles v3 is produced natively by Planetiler when the
# output path ends in .pmtiles (no separate conversion step needed).
OUTPUT_PMTILES_NAME="${OUTPUT_PMTILES_NAME:-north-america.pmtiles}"

# Local paths (relative to infra/tiles/). Each honours a pre-set env value.
DATA_DIR="${DATA_DIR:-./data}"
TMP_DIR="${TMP_DIR:-./data/tmp}"
