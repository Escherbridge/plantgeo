{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/cron-ingest/Dockerfile"
  },
  "deploy": {
    "cronSchedule": "55 22 * * *",
    "restartPolicyType": "NEVER",
    "startCommand": "agri-cli coverage-status --source-key open-meteo-era5-land-archive"
  }
}
