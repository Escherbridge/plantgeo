{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/cron-soilgrids/Dockerfile"
  },
  "deploy": {
    "cronSchedule": "25 * * * *",
    "restartPolicyType": "NEVER",
    "startCommand": "node scripts/warm-soilgrids.mjs 120"
  }
}
