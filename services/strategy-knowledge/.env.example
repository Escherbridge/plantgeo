# Copy to .env (git-ignored). Same object-store variable names as services/agri-data-service/.env.
# OBJECT_STORE_ENDPOINT_URL=https://<bucket-endpoint>
# OBJECT_STORE_BUCKET=<s3-bucket-name, not the display name>
# OBJECT_STORE_REGION=auto
# OBJECT_STORE_ACCESS_KEY_ID=<access-key-id>
# OBJECT_STORE_SECRET_ACCESS_KEY=<secret-access-key>

# Local mirror of the bucket prefix (default: services/strategy-knowledge/.cache).
# STRATEGY_KB_CACHE_DIR=
# Bucket prefix (default: strategy-knowledge/).
# STRATEGY_KB_PREFIX=strategy-knowledge/

# Documents each retriever (dense, BM25) feeds into fusion, independent of the page asked for (default: 300).
# STRATEGY_KB_CANDIDATE_POOL=300

# `serve --transport http`: extra comma-separated Host names /mcp accepts besides loopback, the Railway service host
# and RAILWAY_PRIVATE_DOMAIN (AGENTS.md "HTTP transport"). The tool API does not check the Host header.
# STRATEGY_KB_ALLOWED_HOSTS=
