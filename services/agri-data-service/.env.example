# Database. combined_local is the only profile allowed to use DATABASE_URL.
SERVICE_PROFILE=combined_local
DATABASE_URL=postgresql+asyncpg://geo:<your-postgres-password>@localhost:5432/plantgeo
# Production receiver service: mount only authenticated write routes and use its dedicated login.
# SERVICE_PROFILE=receiver_writer
# RECEIVER_WRITER_DATABASE_URL=postgresql+asyncpg://<receiver-writer>:<password>@<private-host>:5432/plantgeo
# Production forecast serving service: mount only published reads and use the reader-only login.
# SERVICE_PROFILE=published_reader
# PUBLISHED_READER_DATABASE_URL=postgresql+asyncpg://<published-reader>:<password>@<private-host>:5432/plantgeo
# Alembic-only synchronous administrative identity; do not inject into the API service.
DATABASE_URL_SYNC=postgresql://geo:<your-postgres-password>@localhost:5432/plantgeo
# Required only by `agri-cli source-ingest`. It is deliberately isolated from DATABASE_URL.
# Create plantgeo_loader with infra/local-warehouse/create-loader-role.sql first; no owner/5432/default fallback exists.
LOCAL_SOURCE_LOADER_DATABASE_URL=postgresql+asyncpg://plantgeo_loader:<your-loader-password>@127.0.0.1:5442/plantgeo
# Operator-only: a non-elevated NOINHERIT LOGIN that is a member of plantgeo_forecast_mv_refresher.
# Never inject this DSN into the API service or reuse DATABASE_URL.
# FORECAST_MV_REFRESH_DATABASE_URL=postgresql+asyncpg://<refresh-operator>:<password>@<host>:5432/plantgeo
# Local evaluation-only iterations; the database may be a named plantgeo* disposable clone.
# FORECAST_ITERATION_DATABASE_URL=postgresql+asyncpg://plantgeo_local_developer:<password>@127.0.0.1:5442/plantgeo_forecast_test

# Private typed historical promotion receiver/client. Set token and actor only on the Railway receiver.
# HISTORICAL_PROMOTION_API_URL=https://<private-promoter-receiver-domain>
# HISTORICAL_PROMOTION_TOKEN=<at-least-32-diverse-non-whitespace-characters>
# HISTORICAL_PROMOTION_RECEIVER_ENABLED=false
# HISTORICAL_PROMOTION_ACTOR=plantgeo-historical-promoter
# HISTORICAL_PROMOTION_MAX_CHUNK_BYTES=8000000
# HISTORICAL_PROMOTION_MAX_ARTIFACT_BYTES=8000000
# HISTORICAL_PROMOTION_MAX_MANIFEST_BYTES=8000000
# HISTORICAL_PROMOTION_RETRY_ATTEMPTS=5
# HISTORICAL_PROMOTION_RETRY_BASE_SECONDS=0.5
DB_POOL_MIN=2
DB_POOL_MAX=5

# Sanic
SANIC_HOST=0.0.0.0
SANIC_PORT=8000
SANIC_DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3001

# Local-only ETL and model execution (phase one)
EXECUTION_BACKEND=local
CELERY_DISPATCH_ENABLED=false
CLOUD_TRAINING_ENABLED=false
LOCAL_EXECUTION_ROOT=.agri-local-runs

# Shared credential: inject through the operator secret store and Railway separately.
# LOCAL_PUBLISH_TOKEN=

# Operator client: set the API URL. The actor is not sent by the client.
# LOCAL_PUBLISH_API_URL=https://your-agri-service.example/api/v1/local-execution

# Railway receiver: leave API URL unset, enable the gate, and bind the token to an actor.
LOCAL_PUBLICATION_RECEIVER_ENABLED=false
# LOCAL_PUBLISH_ACTOR=plantgeo-local-forecast-publisher
LOCAL_PUBLISH_MAX_ARTIFACT_BYTES=5000000
LOCAL_PUBLISH_MAX_MANIFEST_BYTES=512000
LOCAL_PUBLISH_MAX_VALIDATION_BYTES=256000
LOCAL_PUBLISH_MAX_OUTPUTS=256
LOCAL_PUBLISH_MAX_RUN_ARTIFACT_BYTES=100000000
LOCAL_PUBLISH_MAX_RUN_VALIDATION_BYTES=10000000
LOCAL_PUBLISH_REQUEST_OVERHEAD_BYTES=64000
LOCAL_PUBLISH_RETRY_ATTEMPTS=5
LOCAL_PUBLISH_RETRY_BASE_SECONDS=0.5
