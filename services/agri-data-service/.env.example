# Database
DATABASE_URL=postgresql+asyncpg://geo:<your-postgres-password>@localhost:5432/plantgeo
# Alembic-only synchronous administrative identity; do not inject into the API service.
DATABASE_URL_SYNC=postgresql://geo:<your-postgres-password>@localhost:5432/plantgeo
# Required only by `agri-cli source-ingest`. It is deliberately isolated from DATABASE_URL.
# Create plantgeo_loader with infra/local-warehouse/create-loader-role.sql first; no owner/5432/default fallback exists.
LOCAL_SOURCE_LOADER_DATABASE_URL=postgresql+asyncpg://plantgeo_loader:<your-loader-password>@127.0.0.1:5442/plantgeo
DB_POOL_MIN=2
DB_POOL_MAX=5

# Sanic
SANIC_HOST=0.0.0.0
SANIC_PORT=8000
SANIC_DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3001

# Local-only ETL and model execution (phase one)
EXECUTION_BACKEND=local
CELERY_DISPATCH_ENABLED=false
CLOUD_TRAINING_ENABLED=false
LOCAL_EXECUTION_ROOT=.agri-local-runs

# Shared credential: inject through the operator secret store and Railway separately.
# LOCAL_PUBLISH_TOKEN=

# Operator client: set the API URL. The actor is not sent by the client.
# LOCAL_PUBLISH_API_URL=https://your-agri-service.example/api/v1/local-execution

# Railway receiver: leave API URL unset, enable the gate, and bind the token to an actor.
LOCAL_PUBLICATION_RECEIVER_ENABLED=false
# LOCAL_PUBLISH_ACTOR=plantgeo-local-forecast-publisher
LOCAL_PUBLISH_MAX_ARTIFACT_BYTES=5000000
LOCAL_PUBLISH_MAX_MANIFEST_BYTES=512000
LOCAL_PUBLISH_MAX_VALIDATION_BYTES=256000
LOCAL_PUBLISH_MAX_OUTPUTS=256
LOCAL_PUBLISH_MAX_RUN_ARTIFACT_BYTES=100000000
LOCAL_PUBLISH_MAX_RUN_VALIDATION_BYTES=10000000
LOCAL_PUBLISH_REQUEST_OVERHEAD_BYTES=64000
LOCAL_PUBLISH_RETRY_ATTEMPTS=5
LOCAL_PUBLISH_RETRY_BASE_SECONDS=0.5
