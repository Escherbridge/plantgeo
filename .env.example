# ============================================
# PlantGeo Environment Configuration
# Copy this file to .env.local and fill in values.
# Never commit .env.local or any file with real secrets.
# ============================================

# ============================================
# DATABASE
# ============================================

# PostgreSQL password — used by Docker Compose to initialize the database
# container. Use a generated value outside local development; never deploy the
# example value.
POSTGRES_PASSWORD=

# Optional local QA host-port overrides. Keep the defaults unless another local
# PostgreSQL/Redis/Martin instance already owns them. When changing one, update
# its paired literal URL below (DATABASE_URL, REDIS_URL, MARTIN_URL, and
# NEXT_PUBLIC_DYNAMIC_TILES_URL). Keep literal values: all local tools do not
# expand dotenv variable references consistently.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MARTIN_HOST_PORT=3100
# Full PostgreSQL connection string (PostGIS). Its localhost port
# must match POSTGRES_HOST_PORT above.
# Required. Railway injects this automatically when you attach a Postgres plugin.
DATABASE_URL=postgresql://geo:<your-postgres-password>@localhost:5432/plantgeo

# Optional. DDL-capable DSN used only by the Railway preDeployCommand
# (scripts/migrate.mjs). Leave unset to reuse DATABASE_URL; set it in production
# once the runtime role loses CREATE on the database.
MIGRATION_DATABASE_URL=

# Loopback-only dedicated warehouse access (127.0.0.1:5442).
PLANTGEO_LOCAL_DB_PASSWORD=
PLANTGEO_LOCAL_DEVELOPER_PASSWORD=
PLANTGEO_LOCAL_VIEWER_PASSWORD=
PLANTGEO_FORECAST_REFRESH_PASSWORD=

# ============================================
# REDIS
# ============================================

# Redis connection URL for caching and pub/sub; its localhost port must match
# REDIS_HOST_PORT above. Legacy BullMQ workers remain
# disabled in web replicas and Redis is never the durable job ledger.
# Required. Railway injects this automatically when you attach a Redis plugin.
REDIS_URL=redis://localhost:6379

# ============================================
# TILE SERVER (Martin)
# ============================================

# Internal Martin URL for server-to-server calls only; its localhost port must
# match MARTIN_HOST_PORT above. Do not use a Railway
# private domain in NEXT_PUBLIC_* variables: browsers cannot resolve it.
MARTIN_URL=http://localhost:3100

# Martin service only: exact web origin allowed to request public dynamic tiles.
# infra/martin/martin.yaml's cors.origin is a genuine multi-entry list -- one
# placeholder per origin, because Martin cannot expand a single env var into
# several list entries (see that file's comment for the verified basis). This
# variable fills only the custom-domain entry; the Railway service domain has
# its own placeholder there with a hardcoded-correct default and needs no
# variable here. A domain missing from the list is a silent, browser-only
# outage -- curl returns a clean 200. See docs/deployment.md's "Martin CORS
# allow-list is coupled to the domain set". Railway production value:
# https://plantgeo.aevani.com
TILE_CORS_ORIGIN=http://localhost:3001

# ============================================
# PUBLIC MAP TILE URLS (Next.js client-side)
# NEXT_PUBLIC_ prefix required — these are exposed to the browser.
# ============================================

# URL of the basemap PMTiles file hosted on Cloudflare R2 or similar CDN.
# Replace this development fallback with the project-controlled R2/CDN URL in production.
NEXT_PUBLIC_PMTILES_URL=https://build.protomaps.com/20240801T000000Z.pmtiles

# URL template for terrain/elevation tiles (used for 3D terrain in MapLibre).
# Optional. Defaults to the AWS Open Data terrain tileset.
NEXT_PUBLIC_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Public base URL of the Martin service. Its localhost port must match
# MARTIN_HOST_PORT above. Generate a Railway public/custom domain for Martin;
# never set this to a *.railway.internal hostname. Next.js compiles this value
# into the client bundle during the image build.
NEXT_PUBLIC_DYNAMIC_TILES_URL=http://localhost:3100

# Public base URL of the deployed app (used in emails and embeds).
# Required for production. Example: https://plantgeo.io
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional. Same "west,south,east,north" format as INGEST_BBOX above -- set it
# identically so the opening map camera (computed client-side, synchronously,
# before the getIngestionCoverage query resolves) matches the server's real
# coverage box exactly. When unset, src/lib/map/coverage-region.ts falls back
# to a hardcoded box that mirrors production's current INGEST_BBOX, so the
# opening view is still correct today even without this var -- but a future
# INGEST_BBOX change won't be reflected in the opening camera until this is
# set too. NOTE: as of 2026-08-16 the Dockerfile does not yet forward this as
# a build ARG (see its NEXT_PUBLIC_PMTILES_URL etc. for the pattern) -- add
# `ARG NEXT_PUBLIC_INGEST_BBOX` / `ENV NEXT_PUBLIC_INGEST_BBOX=${NEXT_PUBLIC_INGEST_BBOX}`
# there, and pass it as a Railway build variable, before relying on this var
# in production.
NEXT_PUBLIC_INGEST_BBOX=

# ============================================
# CLOUDFLARE R2 (PMTiles storage)
# Used server-side for tile uploads/ingestion and pre-signed URLs.
# Get credentials from: https://dash.cloudflare.com/ -> R2 -> Manage API tokens
# ============================================

# Name of the R2 bucket holding PMTiles and MBTiles files.
# Required for tile ingestion scripts.
R2_BUCKET=plantgeo-tiles

# R2 S3-compatible endpoint. Replace <ACCOUNT_ID> with your Cloudflare account ID.
# Required for tile ingestion scripts.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# R2 API token key ID. Required for tile ingestion scripts.
R2_ACCESS_KEY_ID=

# R2 API token secret. Required for tile ingestion scripts.
R2_SECRET_ACCESS_KEY=

# ============================================
# ROUTING (Valhalla)
# ============================================

# Base URL of the Valhalla routing engine (multi-modal, isochrones, turn-by-turn).
# Required for routing features. Local default: http://localhost:8002
VALHALLA_URL=http://localhost:8002

# PBF source file URL for building the Valhalla routing graph.
# Required when bootstrapping Valhalla. Download region-specific files from Geofabrik.
# Get from: https://download.geofabrik.de/
VALHALLA_PBF_URL=https://download.geofabrik.de/north-america/us/california-latest.osm.pbf

# ============================================
# GEOCODING (Photon)
# ============================================

# Base URL of the Photon geocoder (autocomplete + reverse geocoding via Nominatim).
# Required for search features. Local default: http://localhost:2322
PHOTON_URL=http://localhost:2322

# Base URL of the agri-data-service HTTP API (published forecast serving).
# Optional in production: when unset there, the vegetation Forecast tab reports
# itself unavailable instead of erroring. Development falls back to the local
# default below, so an unreachable local service shows as a load error, not
# as unavailable. Local default: http://localhost:8000
AGRI_DATA_SERVICE_URL=http://localhost:8000

# Base URL of the agri-data-service Parquet plane -- the day-partitioned
# warehouse the map reads layer rows, day windows, releases and the coverage
# census from (src/lib/server/services/parquet-plane-client.ts).
# REQUIRED in production, unlike AGRI_DATA_SERVICE_URL above: that one is an
# optional forecast bridge that degrades to "unavailable", while this is the
# map's data source, so an unset value throws rather than drawing an empty map.
# Separate from AGRI_DATA_SERVICE_URL so the plane can move to its own
# deployment; point both at the same host while it has not.
# Must be a bare service base URL: no credentials, query string or fragment.
# Local default: http://localhost:8000
AGRI_PARQUET_SERVICE_URL=http://localhost:8000

# ============================================
# AUTH (NextAuth.js)
# ============================================

# Random secret used to sign NextAuth session tokens and JWTs.
# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL of your deployment (used for OAuth callback URLs).
# Required. Must match the redirect URIs configured in your OAuth apps.
NEXTAUTH_URL=http://localhost:3001

# Google OAuth credentials.
# Optional. Get from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials.
# Optional. Get from: https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# EMAIL NOTIFICATIONS
# ============================================

# Email provider to use for sending alert and digest emails.
# Optional. Accepted values: "resend" | "sendgrid"
# If unset, emails are logged to console only (graceful degradation).
EMAIL_PROVIDER=

# Sender address shown in outgoing emails.
# Optional. Defaults to "PlantGeo Alerts <alerts@plantgeo.io>"
EMAIL_FROM=

# Resend API key. Required when EMAIL_PROVIDER=resend.
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# SendGrid API key. Required when EMAIL_PROVIDER=sendgrid.
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# ============================================
# EXTERNAL DATA APIs
# ============================================

# Mapillary access token (server-side) for fetching street-level imagery metadata.
# Optional. Get from: https://www.mapillary.com/developer/api-documentation/
MAPILLARY_ACCESS_TOKEN=

# NASA FIRMS API key for near-real-time fire detection data (VIIRS/MODIS).
# Required only when running the authorized FIRMS ingestion path. The fire UI
# reports unavailable when no persisted detections exist.
# Get from: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_KEY=

# Required for scheduled environmental ingestion. Format:
# west,south,east,north; maximum span is 30 degrees longitude by 20 latitude.
# Start with one operational region and add explicit region jobs as coverage grows.
# Example (Colorado): -109.1,37.0,-102.0,41.1
INGEST_BBOX=

# FIRMS fire-detection lookback window in days. Optional, must be a plain
# non-negative integer string; clamped to 1-10. Default: 2 (VIIRS NRT lags
# hours behind and day windows roll at UTC midnight, so 1 day can read empty
# during early-UTC hours).
FIRMS_DAY_RANGE=

# ============================================
# INGEST LAYER IDs
# Override these only if your Martin/PostGIS setup uses non-default layer names.
# ============================================

# Layer name or UUID for ingested active fire perimeters. Optional. Default: fire-perimeters
FIRES_LAYER_ID=fire-perimeters

# Layer name or UUID for ingested IoT sensor readings. Optional. Default: sensors
SENSORS_LAYER_ID=sensors

# Layer name or UUID for ingested NASA FIRMS fire detections. Optional. Default: fire-detections
FIRMS_LAYER_ID=fire-detections

# Layer name or UUID for ingested USGS streamflow observations.
WATER_GAUGES_LAYER_ID=water-gauges

# Layer name or UUID for persisted Open-Meteo observations.
WEATHER_LAYER_ID=weather-observations

# ============================================
# PLANTCOMMERCE INTEGRATION
# ============================================

# Base URL of the PlantCommerce API.
# Required for PlantCommerce integration (Track 28). Example: https://plantcommerce.example.com
PLANTCOMMERCE_API_URL=

# Webhook endpoint on the PlantCommerce side to push priority-zone updates to.
# Required for priority-zone webhook job.
PLANTCOMMERCE_WEBHOOK_URL=

# HMAC-SHA256 secret used to sign priority-zone webhook payloads.
# Required for priority-zone webhook job.
PLANTCOMMERCE_WEBHOOK_SECRET=

# ============================================
# ADMIN API
# ============================================

# Bearer token required to call admin-only API endpoints (e.g. /api/v1/admin/keys).
# Required in production. Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=

# Temporary, one-way upgrade path for personal API keys issued with bcrypt.
# Legacy clients must also send X-Legacy-Api-Key-Id from key management. Turn it
# off after the migration window.
ALLOW_LEGACY_BCRYPT_API_KEYS=false

# Shared secrets required to accept machine-to-machine ingestion and scheduled
# ingestion requests. Production fails closed when either is missing. Send
# `Authorization: Bearer <secret>` or the respective x-* header.
INGEST_SECRET=
CRON_SECRET=

# Quarantined legacy BullMQ workers must never start inside web replicas. Keep
# disabled; the PostgreSQL-ledger/local runner is the phase-one job mechanism.
ENABLE_LEGACY_BULLMQ_JOBS=false
SERVICE_ROLE=web

# ============================================
# ANTHROPIC AI (Track 31 — AI Regional Intelligence)
# ============================================

# Anthropic API key for Claude-powered regional intelligence features.
# Required for AI features. Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Keep disabled until the regional context reads only versioned warehouse
# publications and its model/evidence gates have passed review.
REGIONAL_INTELLIGENCE_ENABLED=false

# Anthropic model ID to use for regional intelligence responses.
# Optional. Defaults to claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ERA5-Land volumetric soil moisture (Copernicus CDS). Read ONLY by
# `agri-cli historical-era5-backfill`. Listing them here is NOT sufficient:
# historical_era5.py reads os.environ directly, so they must be exported into the
# shell that runs the command. Needs a free CDS account AND the ERA5-Land dataset
# licence accepted in a browser. Every other source is keyless except NASA_FIRMS_KEY.
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=
